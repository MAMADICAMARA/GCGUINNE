# --- Serveur ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
# Optionnel : URL publique du frontend, utilisée pour rediriger un visiteur
# humain qui ouvre un lien de produit MARCHÉ partagé sur les réseaux
# sociaux (backend/src/modules/marketplace/marketplaceShare.routes.js).
# Sans cette variable, la première origine de CORS_ORIGIN ci-dessus est
# utilisée — à définir explicitement seulement si elle diffère.
FRONTEND_URL=http://localhost:5173

# --- Base de données PostgreSQL ---
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestion_commerciale?schema=public

# --- Authentification ---
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

# --- Sécurité ---
BCRYPT_SALT_ROUNDS=12

# --- Stockage d'objets (envoi d'images produits/logo) ---
# Optionnel : sans ces valeurs, "coller un lien" continue de fonctionner,
# seul le bouton "Envoyer une image" échoue proprement.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# --- Envoi d'e-mails transactionnels (SMTP Gmail) ---
# Optionnel : sans ces valeurs, l'application démarre normalement, seul
# l'envoi effectif des e-mails échoue proprement (journalisé, jamais bloquant).
# SMTP_PASSWORD est le "mot de passe d'application" à 16 caractères généré
# dans le compte Google — jamais le mot de passe Gmail normal, et jamais les
# espaces que Google affiche pour la lisibilité (ex: "abcd efgh ijkl mnop"
# doit devenir "abcdefghijklmnop").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
