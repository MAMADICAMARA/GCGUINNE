// ============================================================================
// Schéma Prisma — Plateforme SaaS de Gestion Commerciale Multi-Boutiques
// ============================================================================
// Ce fichier est initialisé volontairement au strict minimum (connexion +
// générateur de client). La modélisation complète des entités (Store, User,
// UserStore, Product, StockMovement, Order, etc. — cf. cahier des charges
// section 10) fera l'objet d'une étape dédiée, afin de ne pas figer un
// schéma non validé avec l'équipe.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Les modèles seront ajoutés ici, module par module, en suivant l'ordre
// de priorité défini dans le cahier des charges (P0 -> P1 -> P2 -> P3).
